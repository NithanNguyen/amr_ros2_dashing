<?xml version="1.0" ?>
<robot name="elderbot">
  <!-- ========================================
       LIDAR SENSOR
       ======================================== -->
  <joint name="laser_joint" type="fixed">
    <parent link="chassis"/>
    <child link="laser_frame"/>
    <origin rpy="0 0 0" xyz="-0.04625 0 0.135"/>
  </joint>
  
  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.03"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="7.583333333333335e-05" ixy="0" ixz="0" iyy="0.00012500000000000003" iyz="0" izz="7.583333333333335e-05"/>
    </inertial>
  </link>

  <gazebo reference="laser_frame">
    <material>Gazebo/Black</material>
  </gazebo>
  
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.3</min>
          <max>20</max>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="gazebo_ros_ray_sensor">
        <ros>
          <argument>~/out:=scan</argument>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_frame</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ========================================
       IMU SENSOR
       ======================================== -->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="chassis"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <material>Gazebo/Blue</material>
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
        <update_rate>100.0</update_rate>
        <!-- Noise parameters (tuỳ chỉnh theo sensor thực) -->
        <angular_velocity_stdev_x>0.01</angular_velocity_stdev_x>
        <angular_velocity_stdev_y>0.01</angular_velocity_stdev_y>
        <angular_velocity_stdev_z>0.01</angular_velocity_stdev_z>
        <linear_acceleration_stdev_x>0.01</linear_acceleration_stdev_x>
        <linear_acceleration_stdev_y>0.01</linear_acceleration_stdev_y>
        <linear_acceleration_stdev_z>0.01</linear_acceleration_stdev_z>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ========================================
       BASE LINKS
       ======================================== -->
  <link name="base_link"></link>
  
  <link name="base_footprint"/>
  
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.152"/>
  </joint>

  <!-- ========================================
       CHASSIS
       ======================================== -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0"/>
  </joint>
  
  <link name="chassis">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.185 0.166 0.24"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry>
        <box size="0.185 0.166 0.24"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4.5"/>
      <inertia ixx="0.015257116666666666" ixy="0" ixz="0" iyy="0.01645197916666666" iyz="0" izz="0.011069095833333332"/>
    </inertial>
  </link>

  <gazebo reference="chassis">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ========================================
       WHEELS
       ======================================== -->
  <!-- FRONT WHEELS -->
  <link name="left_front_wheel">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.035"/>
      <inertia ixx="1.0782916666666668e-05" ixy="0" ixz="0" iyy="1.792e-05" iyz="0" izz="1.0782916666666668e-05"/>
    </inertial>
  </link>

  <link name="right_front_wheel">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.035"/>
      <inertia ixx="1.0782916666666668e-05" ixy="0" ixz="0" iyy="1.792e-05" iyz="0" izz="1.0782916666666668e-05"/>
    </inertial>
  </link>

  <!-- REAR WHEELS -->
  <link name="left_rear_wheel">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.035"/>
      <inertia ixx="1.0782916666666668e-05" ixy="0" ixz="0" iyy="1.792e-05" iyz="0" izz="1.0782916666666668e-05"/>
    </inertial>
  </link>

  <link name="right_rear_wheel">
    <visual>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.025" radius="0.032"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.035"/>
      <inertia ixx="1.0782916666666668e-05" ixy="0" ixz="0" iyy="1.792e-05" iyz="0" izz="1.0782916666666668e-05"/>
    </inertial>
  </link>

  <!-- WHEEL JOINTS -->
  <joint name="left_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_front_wheel"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0.0925 0.0955 -0.12"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <joint name="right_front_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_front_wheel"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0.0925 -0.0955 -0.12"/>
    <axis xyz="0 0 -1"/>
  </joint>
  
  <joint name="left_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_rear_wheel"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="-0.0925 0.0955 -0.12"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <joint name="right_rear_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_rear_wheel"/>
    <origin rpy="1.5707963267948966 0 0" xyz="-0.0925 -0.0955 -0.12"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <!-- WHEEL GAZEBO PROPERTIES -->
  <gazebo reference="right_front_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>0.01</mu2> 
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.005</minDepth>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="left_front_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.005</minDepth>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="left_rear_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1> 
    <mu2>1.0</mu2> 
    <kp>10000000.0</kp> 
    <kd>1.0</kd>
    <minDepth>0.005</minDepth>
    <fdir1>1 0 0</fdir1>
  </gazebo>
  
  <gazebo reference="right_rear_wheel">
    <material>Gazebo/Black</material>
    <mu1>1.0</mu1> 
    <mu2>1.0</mu2> 
    <kp>10000000.0</kp> 
    <kd>1.0</kd>
    <minDepth>0.005</minDepth>
    <fdir1>1 0 0</fdir1> 
  </gazebo>

  <!-- CAMERA -->
  <link name="camera_link">
    <visual name="camera_body_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.024 0.094 0.029"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    
    <visual name="camera_lens_visual">
      <origin xyz="0.015 0 0" rpy="0 1.570796 0"/>
      <geometry>
        <cylinder radius="0.01" length="0.005"/>
      </geometry>
      <material name="black_lens">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.005 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.096 0.031"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/> <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.000006" iyz="0" izz="0.00004"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="chassis"/>
    <child link="camera_link"/>
    <origin xyz="0.1045 0 0.1055" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_link"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <gazebo reference="camera_link">
    <material>Gazebo/DarkGrey</material>
    <sensor type="camera" name="camera1">
      <update_rate>30.0</update_rate>

      <pose>0.02 0 0 0 0 0</pose> 

      <camera name="head">
      <horizontal_fov>1.3962634</horizontal_fov> 
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>my_robot/camera1</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_optical_link</frameName> <hackBaseline>0.07</hackBaseline>
        <distortionK1>0.0</distortionK1>
        <distortionK2>0.0</distortionK2>
        <distortionK3>0.0</distortionK3>
        <distortionT1>0.0</distortionT1>
        <distortionT2>0.0</distortionT2>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ========================================
       DIFFERENTIAL DRIVE PLUGIN
       ======================================== -->
  <gazebo>
    <plugin filename="libgazebo_ros_diff_drive.so" name="diff_drive">
      <update_rate>50</update_rate>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <wheel_separation>0.191</wheel_separation>
      <wheel_diameter>0.064</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
    </plugin>
    
    <plugin filename="libgazebo_ros_joint_state_publisher.so" name="joint_state_publisher">
      <update_rate>10</update_rate>
      <joint_name>left_front_wheel_joint</joint_name>
      <joint_name>right_front_wheel_joint</joint_name>
      <joint_name>left_rear_wheel_joint</joint_name>
      <joint_name>right_rear_wheel_joint</joint_name>
    </plugin>
  </gazebo>
</robot>